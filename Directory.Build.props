<Project>
  <!-- Only active when CI passes -p:EnableCiAnalysis=true; no-op for local/normal builds. C# only (FSC has no ErrorLog) — see Directory.Build.targets for F#. -->
  <PropertyGroup Condition="'$(EnableCiAnalysis)' == 'true'">
    <EnableNETAnalyzers>true</EnableNETAnalyzers>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>AllEnabledByDefault</AnalysisMode>
    <RunAnalyzersDuringBuild>true</RunAnalyzersDuringBuild>
    <ErrorLog>$(MSBuildThisFileDirectory)sarif-results/$(MSBuildProjectName).sarif,version=2.1</ErrorLog>
  </PropertyGroup>

  <!-- Force off so referencing the analyzer package as "analyzers" asset can't make FSC load it during a normal build. -->
  <PropertyGroup Condition="'$(MSBuildProjectExtension)' == '.fsproj'">
    <RunAnalyzers>false</RunAnalyzers>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <EnableDefaultAnalyzerOutputs>false</EnableDefaultAnalyzerOutputs>
  </PropertyGroup>

  <!-- Unconditioned: $(Language) isn't set yet when this file is imported, so a Language condition here would never apply. -->
  <PropertyGroup>
    <GResearchFSharpAnalyzersVersion>0.25.0</GResearchFSharpAnalyzersVersion>
  </PropertyGroup>

  <ItemGroup Condition="'$(MSBuildProjectExtension)' == '.fsproj'">
    <PackageReference Include="FSharp.Analyzers.Build" Version="0.5.0">
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="G-Research.FSharp.Analyzers" Version="$(GResearchFSharpAnalyzersVersion)" GeneratePathProperty="true">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <!-- sarif-results is git-ignored; create it before analysis writes into it. Split so plain local F# builds don't create it unnecessarily. -->
  <Target Name="CreateSarifResultsDirectory" BeforeTargets="BeforeBuild" Condition="'$(EnableCiAnalysis)' == 'true'">
    <MakeDir Directories="$(MSBuildThisFileDirectory)sarif-results" />
  </Target>

  <Target Name="CreateSarifResultsDirectoryForFSharp" BeforeTargets="AnalyzeFSharpProject">
    <MakeDir Directories="$(MSBuildThisFileDirectory)sarif-results" />
  </Target>
</Project>
